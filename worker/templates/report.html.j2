<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Отчёт аудита — {{ project_name }}</title>
<style>
  :root {
    --bg: {{ colors['bg'] }}; --surface: {{ colors['surface'] }};
    --raised: {{ colors['surface-raised'] }};
    --accent: {{ colors['accent'] }}; --accent-strong: {{ colors['accent-strong'] }};
    --ink: {{ colors['ink'] }}; --ink-soft: {{ colors['ink-soft'] }};
    --border: {{ colors['border'] }};
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 24px; background: var(--bg); color: var(--ink);
    font: 16px/1.55 'Segoe UI', 'Trebuchet MS', system-ui, sans-serif;
  }
  .wrap { max-width: 960px; margin: 0 auto; }
  .card {
    background: var(--surface); border-radius: 16px; padding: 24px;
    margin-bottom: 20px; box-shadow: 0 6px 24px rgba(108, 92, 231, 0.25);
  }
  h1 { margin: 0 0 6px; font-size: 26px; }
  h2 { margin: 0; font-size: 20px; }
  .sub { color: var(--ink-soft); font-size: 14px; margin: 0; }
  .headline { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
  .legend { display: flex; flex-direction: column; gap: 6px; }
  .legend span { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .donut { width: 200px; height: 200px; flex: 0 0 auto; }
  .donut-num { font-size: 40px; font-weight: 700; fill: var(--ink); }
  .donut-label { font-size: 14px; fill: var(--ink-soft); }
  .stats { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
  .stat {
    background: var(--raised); border: 1px solid var(--border);
    border-radius: 10px; padding: 8px 14px; font-size: 14px;
  }
  .stat b { font-size: 18px; }
  .meta { margin: 10px 0 0; color: var(--ink-soft); font-size: 13px; }
  .meta li { margin: 2px 0; }
  .section-note { color: var(--ink-soft); font-size: 14px; margin: 0 0 14px; }
  details.section {
    background: var(--surface); border-radius: 16px; padding: 0 24px 8px;
    margin-bottom: 20px; box-shadow: 0 6px 24px rgba(108, 92, 231, 0.25);
  }
  details.section > summary {
    list-style: none; cursor: pointer; padding: 20px 0 16px;
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
    border-bottom: 1px solid transparent;
  }
  details.section[open] > summary { border-bottom-color: var(--border); margin-bottom: 14px; }
  details.section > summary::-webkit-details-marker { display: none; }
  details.section > summary::before {
    content: "▸"; color: var(--accent-strong); font-size: 18px; line-height: 1;
    transition: transform .15s ease;
  }
  details.section[open] > summary::before { transform: rotate(90deg); }
  .section-count {
    color: var(--ink-soft); font-size: 13px; font-weight: 600;
    background: var(--raised); border: 1px solid var(--border);
    border-radius: 999px; padding: 2px 10px;
  }
  .section-body { padding-bottom: 12px; }
  .finding {
    background: var(--raised); border: 1px solid var(--border);
    border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;
    overflow-wrap: anywhere; word-break: break-word; overflow: hidden;
  }
  .finding header { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .finding h3 {
    margin: 0; font-size: 16px; flex: 1; min-width: 0;
    overflow-wrap: anywhere; word-break: break-word;
  }
  .badge {
    color: #fff; border-radius: 999px; padding: 2px 12px;
    font-size: 12px; font-weight: 600; white-space: nowrap;
  }
  .where {
    color: var(--ink-soft); font-size: 13px; margin: 6px 0 10px;
    font-family: Consolas, monospace;
    white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;
  }
  .finding p {
    margin: 6px 0; font-size: 14px;
    white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;
  }
  details.desc {
    margin-top: 4px; font-size: 14px;
    max-width: 100%; overflow: hidden;
  }
  details.desc > summary {
    list-style: none; cursor: pointer; color: var(--accent-strong);
    font-size: 13px; font-weight: 600; margin: 4px 0;
  }
  details.desc > summary::-webkit-details-marker { display: none; }
  details.desc > summary .preview {
    display: block; color: var(--ink); font-weight: 400; margin-top: 4px;
    white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;
  }
  details.desc[open] > summary .preview { display: none; }
  details.desc[open] > summary .more-label::after { content: "Свернуть описание"; }
  details.desc > summary .more-label::after { content: "Показать полностью"; }
  .desc-full {
    white-space: pre-wrap; margin: 8px 0 0;
    overflow-wrap: anywhere; word-break: break-word;
  }
  .fix {
    background: var(--surface); border-left: 4px solid var(--accent-strong);
    border-radius: 8px; padding: 10px 14px; font-size: 14px; margin-top: 10px;
    white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;
  }
  details.section, .section-body, .card, .wrap {
    max-width: 100%; overflow-x: hidden;
  }
  .fix b { color: var(--accent-strong); }
  .empty { color: var(--ink-soft); font-style: italic; }
  .foot { color: var(--ink-soft); font-size: 13px; text-align: center; margin-top: 8px; }
</style>
</head>
<body>
<div class="wrap">

  <div class="card">
    <h1>Отчёт аудита безопасности</h1>
    <p class="sub">Проект: <b>{{ project_name }}</b> · сформирован {{ generated_at }} · скан {{ scan_id[:8] }}</p>
    <div class="headline">
      {{ donut | safe }}
      <div class="legend">
        {% for severity, color in severity_colors.items() %}
          {% if counts.get(severity) %}
          <span><i class="dot" style="background: {{ color }};"></i>
            {{ { 'critical': 'Критический', 'high': 'Высокий', 'medium': 'Средний',
                 'low': 'Низкий', 'info': 'Информация' }[severity] }} — {{ counts[severity] }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="stats">
      <span class="stat">Всего находок: <b>{{ total }}</b></span>
      {% if summary.high_or_above %}<span class="stat">Критичных и высоких: <b>{{ summary.high_or_above }}</b></span>{% endif %}
      {% if summary.ai_findings %}<span class="stat">От ИИ-анализа: <b>{{ summary.ai_findings }}</b></span>{% endif %}
      {% for lang in summary.languages_run | default([]) %}<span class="stat">Язык: <b>{{ lang }}</b></span>{% endfor %}
    </div>
    {% if meta_lines %}
    <ul class="meta">
      {% for line in meta_lines %}<li>{{ line }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>

  {% for section in sections %}
  <details class="section"{% if loop.first %} open{% endif %}>
    <summary>
      <h2>{{ section.label }}</h2>
      <span class="section-count">{{ section.findings | length }}</span>
    </summary>
    <div class="section-body">
    {% if section.dast %}
    <p class="section-note">
      Статус: <b>{{ section.dast.status or '—' }}</b>
      {% if section.dast.target_url %} · цель: {{ section.dast.target_url }}{% endif %}
    </p>
    {% endif %}
    {% if section.id == 'pentest' %}
    <p class="section-note">
      {% if section.security and section.security.status %}
        Ревью гипотез: <b>{{ section.security.status }}</b>
        {% if section.security.hypotheses is defined %} · гипотез: {{ section.security.hypotheses }}{% endif %}
      {% endif %}
      {% if section.pentest and section.pentest.status %}
        {% if section.security and section.security.status %} · {% endif %}
        Активный агент: <b>{{ section.pentest.status }}</b>
        {% if section.pentest.mode %} ({{ section.pentest.mode }}){% endif %}
      {% endif %}
    </p>
    {% endif %}
    {% if section.attack_surface %}
    <p class="section-note">
      {% if section.ranking %}Ранжирование: <b>{{ section.ranking }}</b> · {% endif %}
      {% if section.attack_surface.tools %}
        Инструменты:
        {% for tool, st in section.attack_surface.tools.items() %}
          {{ tool }}{% if st.findings is defined %} ({{ st.findings }}){% endif %}{% if not loop.last %}, {% endif %}
        {% endfor %}
      {% endif %}
      {% if section.attack_surface.entry_points %}
        · точки входа: {% for k, v in section.attack_surface.entry_points.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}
      {% endif %}
      {% if section.attack_surface.sinks_by_cwe %}
        · sinks: {% for k, v in section.attack_surface.sinks_by_cwe.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}
      {% endif %}
    </p>
    {% endif %}
    {% if section.llm_meta and section.llm_meta.status %}
    <p class="section-note">
      Статус LLM: <b>{{ section.llm_meta.status }}</b>
      {% if section.llm_meta.model %} · модель {{ section.llm_meta.model }}{% endif %}
      {% if section.llm_meta.modes %} · режимы: {{ section.llm_meta.modes | join(', ') }}{% endif %}
    </p>
    {% endif %}
    {% if section.findings %}
      {% for f in section.findings %}
      <div class="finding">
        <header>
          <span class="badge" style="background: {{ severity_colors.get(f.severity, severity_colors['info']) }};">
            {{ { 'critical': 'Критический', 'high': 'Высокий', 'medium': 'Средний',
                 'low': 'Низкий', 'info': 'Информация' }.get(f.severity, f.severity) }}
          </span>
          <h3>{{ f.position }}. {{ f.title }}</h3>
        </header>
        {% if f.file or f.url or f.cwe or f.rule_id or f.source %}
        <p class="where">
          {%- if f.file %}{{ f.file }}{% if f.line %}:{{ f.line }}{% endif %}{% endif %}
          {%- if f.url %}{% if f.file %} · {% endif %}{{ f.url }}{% endif %}
          {%- if f.cwe %} · {{ f.cwe }}{% endif %}
          {%- if f.rule_id %} · {{ f.rule_id }}{% endif %}
          {%- if f.source %} · источник: {{ f.source }}{% endif %}
          {%- if f.tools %} · tools: {{ f.tools | join('+') }}{% endif %}
          {%- if f.verdict %} · вердикт: {{ f.verdict }}{% endif %}
        </p>
        {% endif %}
        {% if f.description %}
          {% if f.description_collapse %}
          <details class="desc">
            <summary>
              <span class="more-label"></span>
              <span class="preview">{{ f.description_preview }}</span>
            </summary>
            <div class="desc-full">{{ f.description }}</div>
          </details>
          {% else %}
          <p>{{ f.description }}</p>
          {% endif %}
        {% endif %}
        {% if f.triage and f.triage.explanation %}
        <p class="where">Triage: {{ f.triage.explanation }}</p>
        {% endif %}
        {% if f.dataflow %}
        <p class="where">Dataflow:
          {% for step in f.dataflow[:6] %}
            {{ step.file or step.path or '?' }}{% if step.line or step.start_line %}:{{ step.line or step.start_line }}{% endif %}{% if not loop.last %} → {% endif %}
          {% endfor %}
        </p>
        {% endif %}
        {% if f.evidence %}<p class="where">Доказательство: {{ f.evidence }}</p>{% endif %}
        {% if f.remediation %}<div class="fix"><b>Как исправить:</b> {{ f.remediation }}</div>{% endif %}
      </div>
      {% endfor %}
    {% else %}
      <p class="empty">Находок по этому методу нет.</p>
    {% endif %}
    </div>
  </details>
  {% else %}
  <div class="card">
    <h2>Находки и рекомендации</h2>
    <p class="empty">Уязвимостей не обнаружено.</p>
  </div>
  {% endfor %}

  <p class="foot">Отчёт сформирован автоматически сервисом анализа репозиториев и не заменяет ручной аудит безопасности.</p>
</div>
</body>
</html>
