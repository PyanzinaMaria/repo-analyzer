# Copy to .env and adjust. Every variable overrides the corresponding YAML value.

# Application
SIRIUS_APP_TITLE=Аудитор кода
SIRIUS_BASE_URL=http://127.0.0.1:8000
SIRIUS_APP_ROOT=            # repo root; auto-detected when empty

# Server
SIRIUS_HOST=0.0.0.0
SIRIUS_PORT=8000
SIRIUS_MAX_BODY_BYTES=52428800

# Storage (paths are resolved under APP_ROOT unless absolute)
SIRIUS_DATA_DIR=data
