APP_NAME=repo-analyzer
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=data/workspaces
SETTINGS_PATH=config/settings.yaml
GIT_TIMEOUT_SECONDS=120

# Optional AI code review (OpenAI-compatible). Module stays off without a key.
# AI_ENABLED=true
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# LLM stage (triage / discovery). With base_url on OpenRouter, OPENROUTER_API_KEY is used when AI_API_KEY is empty.
# OPENROUTER_API_KEY=
# AI_MODES=triage,discovery
# Static analyzers for one run (default: config/settings.yaml sast.tools); "none" disables SAST.
# SECAUDIT_SAST_TOOLS=bandit,semgrep

# Benchmark data for `python -m bench` (default ./data/bench). In WSL use the ext4 filesystem:
# SECBENCH_DATA=~/secbench-data
